{"id": "window", "name": "Window in wall line", "category": "building/window", "kind": "parametric", "tags": ["window"], "units": "mm", "parameters": {"W": {"min": 600, "max": 2400, "default": 1200}, "sill": {"min": 600, "max": 1200, "default": 900}, "wH": {"min": 600, "max": 1500, "default": 1200}, "t": {"min": 100, "max": 400, "default": 230}, "H": {"min": 2800, "max": 4500, "default": 3000}}, "shapes": [{"id": "below", "role": "solid", "type": "box", "size": ["$W", "$t", "$sill"], "at": [0, 0, "$sill/2"], "tags": ["masonry"]}, {"id": "glass", "role": "solid", "type": "box", "size": ["$W", "$t*0.2", "$wH"], "at": [0, 0, "$sill+$wH/2"], "tags": ["glass"]}, {"id": "above", "role": "solid", "type": "box", "size": ["$W", "$t", "$H-$sill-$wH"], "at": [0, 0, "$sill+$wH+($H-$sill-$wH)/2"], "tags": ["masonry"]}], "ports": [{"id": "L", "at": ["-$W/2", 0, 0], "dir": [-1, 0, 0], "type": "face-h"}, {"id": "R", "at": ["$W/2", 0, 0], "dir": [1, 0, 0], "type": "face-h"}]}