  "shapes": [ { "id": "barrel", "role": "solid", "type": "cylinder", "axis": "y", "radius": "$OD/2", "length": "$len" } ],
  "ports": [ { "id": "A", "at": [0,"-$len/2",0], "dir": [0,-1,0], "type": "flange", "DN": "$DN", "PN": "$PN", "std": "EN1092-2" },
             { "id": "B", "at": [0,"$len/2",0], "dir": [0,1,0], "type": "flange", "DN": "$DN", "PN": "$PN", "std": "EN1092-2" } ] }
