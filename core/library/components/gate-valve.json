{ "id": "gate-valve", "name": "Gate valve, flanged (EN 558 series 14)", "category": "water-supply/valve", "kind": "parametric", "tags": ["valve"], "units": "mm",
  "parameters": { "DN": {"min":100,"max":600,"default":300}, "PN": {"default":16}, "open": {"min":0,"max":1,"default":1} },
  "derived": { "FTF": { "from": "DN", "table": {"100":190,"150":210,"200":230,"250":250,"300":270,"400":310,"500":350,"600":390} },
               "FOD": { "from": "DN", "table": {"100":220,"150":285,"200":340,"250":405,"300":460,"400":580,"500":715,"600":840} } },
  "shapes": [ { "id": "body", "role": "solid", "type": "cylinder", "axis": "y", "radius": "$FOD/2", "length": "$FTF" },
              { "id": "bonnet", "role": "solid", "type": "box", "size": ["$DN*0.6", "$FTF*0.6", "$DN*0.9"], "at": [0, 0, "$FOD/2+$DN*0.45-20"] },
              { "id": "handwheel-zone", "role": "clearance", "type": "box", "size": ["$DN*0.9", "$DN*0.9", 300], "at": [0, 0, "$FOD/2+$DN*0.9+150"] } ],
  "ports": [ { "id": "A", "at": [0,"-$FTF/2",0], "dir": [0,-1,0], "type": "flange", "DN": "$DN", "PN": "$PN", "std": "EN1092-2" },
             { "id": "B", "at": [0,"$FTF/2",0], "dir": [0,1,0], "type": "flange", "DN": "$DN", "PN": "$PN", "std": "EN1092-2" } ],
  "states": { "open": "gate position 0 closed .. 1 open (visual only)" } }
