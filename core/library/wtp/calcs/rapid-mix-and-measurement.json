{
  "stage": "rapid-mix-and-measurement",
  "calculations": [
    {
      "id": "parshall-free-flow",
      "name": "Parshall free-flow discharge (Ha to Q)",
      "inputs": [
        "throat_width",
        "Ha"
      ],
      "outputs": [
        "Q"
      ],
      "status": "tested",
      "sources": [
        {
          "ref": "UTAH66",
          "loc": "Table 3"
        },
        {
          "ref": "ARKON11",
          "loc": "Section 3, equation 1"
        }
      ],
      "tests": [
        "core/tests/parshall.mjs"
      ],
      "implementedIn": "core/engine/wtp/parshall.js",
      "note": "Table 3 as a power law per throat width, within about two units of the last printed digit."
    },
    {
      "id": "parshall-submerged",
      "name": "Parshall submerged-flow discharge",
      "inputs": [
        "throat_width",
        "Ha",
        "Hb"
      ],
      "outputs": [
        "Q",
        "correction"
      ],
      "status": "planned",
      "sources": [
        {
          "ref": "UTAH66",
          "loc": "Figures 4-18"
        }
      ],
      "note": "Needs the calibration curves of Figures 6-18, not digitised."
    },
    {
      "id": "parshall-size-selection",
      "name": "Flume size from maximum flow, depth and head loss",
      "inputs": [
        "flow_range",
        "allowable_head_loss",
