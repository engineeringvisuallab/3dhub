      ],
      "outputs": [
        "throat_width"
      ],
      "status": "tested",
      "sources": [
        {
          "ref": "UTAH66",
          "loc": "Figure 19, Example 4"
        }
      ],
      "tests": [
        "core/tests/parshall.mjs"
      ],
      "implementedIn": "core/engine/wtp/parshall.js",
      "note": "Free-flow selection using Table 3 and Table 2 (reproduces Example 4); the Figure 19 chart is not used."
    },
    {
      "id": "parshall-dimensions",
