      "types": [
        {
          "id": "parshall-flume",
          "name": "Parshall flume",
          "status": "model3d",
          "definition": "An open-channel flume with a converging inlet, a short parallel throat whose floor slopes down, and a diverging outlet whose floor rises. The size is named by the throat width W.",
          "how": "The contraction and floor drop force flow through critical depth in the throat, so discharge follows from the upstream depth Ha alone (free flow) or from Ha and the throat depth Hb (submerged flow).",
          "suits": [
            "Measuring open-channel flow with little head loss",
            "A fixed point in a channel where a hydraulic jump can be used for rapid mixing",
            "Flow ranges from about 0.03 cfs (3 inch) up to 3,000 cfs (50 ft) in the Utah report"
          ],
          "avoid": [
            "A site with no available fall unless operation under submergence is designed for",
            "Unscreened flow carrying debris larger than the guide allows",
            "A position close to a gate or bend that disturbs the approach flow"
          ],
          "sources": [
            {
              "ref": "UTAH66",
